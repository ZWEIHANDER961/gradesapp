datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CursoSeccion {
  id          String         @id @default(uuid())
  nombre      String
  estudiantes Estudiante[]
  materias    CursoMateria[]
}

model Materia {
  id     String         @id @default(uuid())
  nombre String         @unique 
  cursos CursoMateria[]
}

model CursoMateria {
  id        String                 @id @default(uuid())
  cursoId   String
  materiaId String
  curso     CursoSeccion           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  materia   Materia                @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  ras       ResultadoAprendizaje[]

  @@unique([cursoId, materiaId])
}

model Estudiante {
  id             String         @id @default(uuid())
  numeroOrden    Int            
  nombre         String
  apellido       String
  cursoId        String
  curso          CursoSeccion   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  calificaciones Calificacion[]

  @@unique([cursoId, numeroOrden])
}

model ResultadoAprendizaje {
  id             String       @id @default(uuid())
  codigoRA       String       
  descripcion    String       @db.Text
  ponderacion    Int          
  cursoMateriaId String
  cursoMateria   CursoMateria @relation(fields: [cursoMateriaId], references: [id], onDelete: Cascade)
  actividades    Actividad[]
}

model Actividad {
  id             String               @id @default(uuid())
  nombre         String
  ponderacion    Int                  
  raId           String
  ra             ResultadoAprendizaje @relation(fields: [raId], references: [id], onDelete: Cascade)
  calificaciones Calificacion[]
}

model Calificacion {
  id           String     @id @default(uuid())
  estudianteId String
  actividadId  String
  puntaje      Float      
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  actividad    Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, actividadId])
}